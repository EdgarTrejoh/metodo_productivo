# Ejemplo para prueba local aislada. Copiar a .env.staging-smoke (excluido de Git).
# Staging real requiere hosts/orígenes propios y secretos independientes.
DJANGO_ENV=staging
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://127.0.0.1:8877
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_ESTABLE_DE_50_CARACTERES_O_MAS
DB_ENGINE=postgresql
PGDATABASE=metodo_productivo_staging_smoke
PGUSER=metodo_productivo_staging_smoke
PGPASSWORD=REEMPLAZAR_CON_PASSWORD_ALEATORIO
PGHOST=db
PGPORT=5432
DJANGO_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
CONTACT_NOTIFICATION_EMAIL=
PRIVATE_RESOURCE_ROOT=/app/private_resources
STORE_TEST_CHECKOUT_ENABLED=0
