# Copia este archivo a .env.docker y reemplaza los dos valores de ejemplo.
# .env.docker está excluido de Git. Uso exclusivo en desarrollo local.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_ESTABLE
DB_ENGINE=postgresql
PGDATABASE=metodo_productivo_dev
PGUSER=metodo_productivo_dev
PGPASSWORD=REEMPLAZAR_CON_PASSWORD_ALEATORIO
PGHOST=db
PGPORT=5432
DJANGO_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
CONTACT_NOTIFICATION_EMAIL=
PRIVATE_RESOURCE_ROOT=/app/private_resources
PRIVATE_RESOURCE_HOST_PATH=./private_resources
STORE_TEST_CHECKOUT_ENABLED=0
