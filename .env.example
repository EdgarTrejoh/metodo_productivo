# Copiar los valores al entorno; Django no carga .env automáticamente.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Para probar PostgreSQL: DB_ENGINE=postgresql y configurar PGDATABASE, PGUSER,
# PGPASSWORD, PGHOST y PGPORT; no incluir secretos en Git.
CHECK_CONTEXT_TTL_SECONDS=1800
# Duración provisional para pruebas; requiere decisión antes de producción.
